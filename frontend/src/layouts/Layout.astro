---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Full-Stack Developer & Backend Engineer" } = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen">
    <header class="fixed top-0 left-0 right-0 z-50 bg-slate-950/90 backdrop-blur-sm border-b border-slate-800">
      <nav class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="text-xl font-bold text-primary hover:text-primary-light transition-colors">
            SamuelHolmes.tech
          </a>
          <div class="flex gap-6">
            <a href="#about" class="text-slate-300 hover:text-primary transition-colors">About</a>
            <a href="#stack" class="text-slate-300 hover:text-primary transition-colors">Stack</a>
            <a href="#projects" class="text-slate-300 hover:text-primary transition-colors">Projects</a>
            <a href="#contact" class="text-slate-300 hover:text-primary transition-colors">Contact</a>
          </div>
        </div>
      </nav>
    </header>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="border-t border-slate-800 mt-20">
      <div class="container mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="text-slate-400 text-sm">© Samuel Holmes - {new Date().getFullYear()}</p>
          <div class="flex gap-4">
            <a href="https://github.com/samuelholmes" target="_blank" rel="noopener noreferrer" 
               class="text-slate-400 hover:text-primary transition-colors">
              GitHub
            </a>
            <a href="https://linkedin.com/in/samuelholmes" target="_blank" rel="noopener noreferrer"
               class="text-slate-400 hover:text-primary transition-colors">
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
