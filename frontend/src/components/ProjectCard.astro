---
import type { Project } from '../generated/graphql.ts';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group bg-slate-900 border border-slate-800 rounded-lg overflow-hidden hover:border-primary transition-all duration-300">
  {project.imageUrl && (
    <div class="aspect-square overflow-hidden bg-slate-800">
      <img 
        src={project.imageUrl}
        alt={project.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}
  
  <div class="p-6">
    <div class="flex items-start justify-between mb-3">
      <h3 class="text-xl font-bold text-slate-100 group-hover:text-primary transition-colors">
        {project.title}
      </h3>
      {project.featured && (
        <span class="px-2 py-1 bg-accent/20 text-accent-bright text-xs font-medium rounded">
          Featured
        </span>
      )}
    </div>

    <p class="text-slate-400 mb-4 leading-relaxed whitespace-pre-line">
      {project.description}
    </p>

    <div class="flex flex-wrap gap-2 mb-4">
      {project.techStack.map((tech) => (
        <span class="px-3 py-1 bg-slate-800 text-slate-300 text-sm rounded-full">
          {tech}
        </span>
      ))}
    </div>

    <div class="flex gap-3">
      {project.liveUrl && (
        <a 
          href={project.liveUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-4 py-2 bg-primary hover:bg-primary-light text-slate-950 font-medium rounded transition-colors"
        >
          View Live
        </a>
      )}
      {project.githubUrl && (
        <a 
          href={project.githubUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-100 font-medium rounded transition-colors"
        >
          GitHub
        </a>
      )}
    </div>
  </div>
</article>
